stateDiagram-v2
  state "Legend" as legend {
    lg0: Open
    lg1: Closed
    lg2: Breaks NoRefundBeforePayment in some cases
    lg3: Path to the NoRefundBeforePayment bug
  }
  class lg0 blue
  class lg1 tan
  class lg2 mayBreak
  class lg3 bugPath
  s0: Placed
  s1: Cancelled
  s2: Refunded
  s3: Paid
  s4: Shipped
  [*] --> s0
  s0 --> s1: you cancel
  s0 --> s2: you ask for a refund
  s0 --> s3: you pay
  s3 --> s1: you cancel
  s3 --> s2: you ask for a refund
  s3 --> s4: the order ships
  s4 --> s2: you ask for a refund
